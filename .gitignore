# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — o .env tem segredos e nunca vai para o Git.
# O .env.example vai, porque é o modelo que a próxima pessoa copia.
.env*
!.env.example

# Planilhas de controle têm nomes reais de membros e situação de recomendação.
# Nunca versionar: o repositório pode virar público, o dado não pode.
*.xlsx
*.xls
*.csv

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Configurações locais de ferramentas de IA/editor
/.agents
/.windsurf
/skills-lock.json
