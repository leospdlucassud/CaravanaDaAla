# =============================================================================
# Caravana ao Templo — variáveis de ambiente
#
# Copie este arquivo para `.env` e preencha. O `.env` nunca vai para o Git.
#   No Windows (PowerShell):  Copy-Item .env.example .env
# =============================================================================

# --- Banco de dados (Neon) ---------------------------------------------------
# No painel do Neon, em "Connection string", copie as DUAS versões:
#
#  DATABASE_URL  -> a versão COM pooler (o host termina em "-pooler").
#                   É a que a aplicação usa no dia a dia.
#  DIRECT_URL    -> a versão SEM pooler.
#                   É a que as migrações usam (o pooler não aceita os comandos
#                   que criam tabelas).
#
# Mantenha `?sslmode=require` no fim das duas.
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://usuario:senha@ep-exemplo.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# --- Autenticação ------------------------------------------------------------
# Segredo usado para assinar a sessão. Gere um novo com:
#   npx auth secret
# Nunca reaproveite o mesmo segredo entre o seu computador e a Vercel.
AUTH_SECRET="troque-por-um-valor-gerado"

# Endereço público do app. Em desenvolvimento é o localhost mesmo.
# Na Vercel, use o domínio de produção (https://...).
AUTH_URL="http://localhost:3000"

# E-mails que entram como ADMINISTRADOR no primeiro acesso, separados por
# vírgula. Comece pelo seu.
ADMIN_EMAILS="voce@exemplo.com"

# --- Envio do link de acesso (Resend) ---------------------------------------
# OPCIONAL em desenvolvimento: sem a chave, o link de acesso é impresso no
# terminal onde você rodou `npm run dev` — dá para copiar e colar no navegador.
#
# Em produção é OBRIGATÓRIO, senão ninguém recebe o link para entrar.
# Crie a chave em https://resend.com (o plano gratuito atende uma ala com folga).
AUTH_RESEND_KEY=""

# Remetente dos e-mails. Enquanto você não verificar um domínio próprio no
# Resend, use o remetente de teste deles.
EMAIL_FROM="onboarding@resend.dev"

# --- Preparo inicial do banco (opcional) ------------------------------------
# Usados só pelo `npm run db:seed`, para já criar a sua unidade.
SEED_UNIDADE_NOME=""
SEED_UNIDADE_ESTACA=""
